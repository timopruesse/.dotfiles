{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "palette": {
    "os": "#ACB0BE",
    "pink": "#F5BDE6",
    "lavender": "#B7BDF8",
    "blue": "#8AADF4",
    "wight": "#FFFFFF",
    "text": "#494D64",
    "peach": "#F5A97F",
    "green": "#A6DA95",
    "red": "#ED8796",
    "yellow": "#EED49F",
    "overlay": "#6E738D"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "powerline_symbol": "\ue0b4",
          "background": "p:pink",
          "foreground": "p:text",
          "template": " {{ .Path }}",
          "options": {
            "style": "agnoster_short",
            "home_icon": "~",
            "folder_icon": "\ue5fe"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b4",
          "background": "p:lavender",
          "foreground": "p:text",
          "template": " {{ .HEAD }}{{ if .Working.Changed }}*{{ end }}{{ if .Staging.Changed }}+{{ end }}{{ if gt .Ahead 0 }}↑{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }}↓{{ .Behind }}{{ end }}",
          "options": {
            "fetch_status": true,
            "branch_icon": "\ue725 "
          }
        },
        {
          "type": "project",
          "style": "powerline",
          "powerline_symbol": "\ue0b4",
          "background": "p:blue",
          "foreground": "p:text",
          "template": " {{ .Name }}{{ if .Version }}@{{ .Version }}{{ end }}"
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "\ue0b4",
          "background": "p:green",
          "foreground": "p:text",
          "template": " \ue718 {{ .Full }}",
          "options": {
            "display_mode": "context",
            "home_enabled": false
          }
        },
        {
          "type": "rust",
          "style": "powerline",
          "powerline_symbol": "\ue0b4",
          "background": "p:peach",
          "foreground": "p:text",
          "template": " \ue7a8 {{ .Full }}",
          "options": {
            "display_mode": "context",
            "home_enabled": false
          }
        },
        {
          "type": "bun",
          "style": "powerline",
          "powerline_symbol": "\ue0b4",
          "background": "p:yellow",
          "foreground": "p:text",
          "template": " \ue76f {{ .Full }}",
          "options": {
            "display_mode": "context",
            "home_enabled": false
          }
        },
        {
          "type": "svelte",
          "style": "powerline",
          "powerline_symbol": "\ue0b4",
          "background": "p:red",
          "foreground": "p:wight",
          "template": " \ue697 {{ .Full }}",
          "options": {
            "display_mode": "files",
            "home_enabled": false
          }
        },
        {
          "type": "aws",
          "style": "powerline",
          "powerline_symbol": "\ue0b4",
          "background": "p:peach",
          "foreground": "p:text",
          "template": " \ue7ad {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }}",
          "options": {
            "display_default": false
          }
        },
        {
          "type": "claude",
          "style": "powerline",
          "powerline_symbol": "\ue0b4",
          "background": "p:blue",
          "foreground": "p:wight",
          "template": " \ueb99 {{ .Model.DisplayName }} {{ .TokenGauge }} {{ .FormattedCost }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": ["{{ if .Error }}p:red{{ end }}"],
          "template": "{{ if .Executed }}{{ if .Error }}\uf071 {{ .Code }}{{ end }}{{ end }}",
          "options": {
            "always_enabled": false
          }
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:overlay",
          "template": " {{ .FormattedMs }}",
          "options": {
            "threshold": 3000,
            "style": "austin"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": ["{{ if gt .Code 0 }}p:red{{ end }}"],
          "template": "❯"
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:green",
    "foreground_templates": ["{{ if gt .Code 0 }}p:red{{ end }}"],
    "template": "❯ "
  },
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": true,
    "notice": true
  }
}
