{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "async": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:pink",
          "background": "transparent",
          "template": " {{ .Path }}",
          "powerline_symbol": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "options": {
            "style": "agnoster_short",
            "home_icon": "~",
            "folder_icon": "\ue5fe"
          }
        },
        {
          "type": "project",
          "style": "plain",
          "foreground": "p:blue",
          "background": "transparent",
          "template": " {{ .Name }}{{ if .Version }}@{{ .Version }}{{ end }}",
          "powerline_symbol": "\ue0b4"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:lavender",
          "background": "transparent",
          "template": " {{ .HEAD }}{{ if .Working.Changed }}*{{ end }}{{ if .Staging.Changed }}+{{ end }}{{ if gt .Ahead 0 }}\u2191{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }}\u2193{{ .Behind }}{{ end }}",
          "powerline_symbol": "\ue0b4",
          "options": {
            "fetch_status": true,
            "branch_icon": "\ue725 "
          }
        },
        {
          "type": "aws",
          "style": "plain",
          "foreground": "p:orange",
          "background": "transparent",
          "template": " \ue7ad {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }}",
          "powerline_symbol": "\ue0b4",
          "options": {
            "display_default": false
          }
        },
        {
          "type": "claude",
          "style": "plain",
          "foreground": "p:peach",
          "foreground_templates": [
            "{{ if .Env.AGY_AGENT }}p:blue{{ end }}",
            "{{ if .Env.CURSOR_AGENT }}p:wight{{ end }}"
          ],
          "background": "transparent",
          "template": " \ueb99 {{ .Model.DisplayName }}{{ $tokens := \"\" }}{{ if .Env.AGENT_REMAINING }}{{ $tokens = .Env.AGENT_REMAINING }}{{ else if and .ContextWindow .ContextWindow.ContextWindowSize (gt .ContextWindow.ContextWindowSize 0) }}{{ $rem := sub .ContextWindow.ContextWindowSize (add .ContextWindow.TotalInputTokens .ContextWindow.TotalOutputTokens) }}{{ if ge $rem 1000000 }}{{ $tokens = printf \"%.1fm\" (divf $rem 1000000) }}{{ else if ge $rem 10000 }}{{ $tokens = printf \"%dk\" (div $rem 1000) }}{{ else if ge $rem 1000 }}{{ $tokens = printf \"%.1fk\" (divf $rem 1000) }}{{ else if gt $rem 0 }}{{ $tokens = printf \"%d\" $rem }}{{ else }}{{ $tokens = \"0\" }}{{ end }}{{ end }}{{ if $tokens }} {{ $tokens }}{{ end }}{{ if .Env.AGENT_POOL }}{{ if $tokens }} · {{ else }} {{ end }}{{ .Env.AGENT_POOL }}{{ else if and .RateLimits .RateLimits.FiveHour }}{{ if gt .Cost.TotalCostUSD 0.0 }}{{ if $tokens }} · {{ else }} {{ end }}{{ .FormattedCost }} · {{ sub 100 (int .RateLimits.FiveHour.UsedPercentage) }}% 5h{{ else }}{{ if $tokens }} · {{ else }} {{ end }}{{ sub 100 (int .RateLimits.FiveHour.UsedPercentage) }}% 5h{{ end }}{{ else if and .RateLimits .RateLimits.SevenDay }}{{ if gt .Cost.TotalCostUSD 0.0 }}{{ if $tokens }} · {{ else }} {{ end }}{{ .FormattedCost }} · {{ sub 100 (int .RateLimits.SevenDay.UsedPercentage) }}% 7d{{ else }}{{ if $tokens }} · {{ else }} {{ end }}{{ sub 100 (int .RateLimits.SevenDay.UsedPercentage) }}% 7d{{ end }}{{ else if gt .Cost.TotalCostUSD 0.0 }}{{ if $tokens }} · {{ else }} {{ end }}{{ .FormattedCost }}{{ else if not $tokens }}{{ if .FormattedCost }} {{ .FormattedCost }}{{ end }}{{ end }}",
          "powerline_symbol": "\ue0b4"
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:green",
          "background": "transparent",
          "template": " \ue718 {{ .Full }}",
          "powerline_symbol": "\ue0b4",
          "options": {
            "display_mode": "context",
            "home_enabled": false
          }
        },
        {
          "type": "bun",
          "style": "plain",
          "foreground": "p:yellow",
          "background": "transparent",
          "template": " \ue76f {{ .Full }}",
          "powerline_symbol": "\ue0b4",
          "options": {
            "display_mode": "context",
            "home_enabled": false
          }
        },
        {
          "type": "svelte",
          "style": "plain",
          "foreground": "p:red",
          "background": "transparent",
          "template": " \ue697 {{ .Full }}",
          "powerline_symbol": "\ue0b4",
          "options": {
            "display_mode": "files",
            "home_enabled": false
          }
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:peach",
          "background": "transparent",
          "template": " \ue7a8 {{ .Full }}",
          "powerline_symbol": "\ue0b4",
          "options": {
            "display_mode": "context",
            "home_enabled": false
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if .Error }}p:red{{ end }}"
          ],
          "template": "{{ if .Executed }}{{ if .Error }}\uf071 {{ .Code }}{{ end }}{{ end }}",
          "options": {
            "always_enabled": false
          }
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:overlay",
          "template": " {{ .FormattedMs }}",
          "options": {
            "threshold": 3000,
            "style": "austin"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "vimode",
          "style": "diamond",
          "powerline_symbol": "\ue0b0",
          "template": "{{ if and (not .Env.CLAUDECODE) (not .Env.CURSOR_AGENT) (not .Env.AGY_AGENT) }}{{ .Mode }}{{ end }}",
          "foreground": "p:text",
          "background": "p:green",
          "background_templates": [
            "{{ if eq .Mode \"insert\" }}p:green{{ end }}",
            "{{ if eq .Mode \"normal\" }}p:lavender{{ end }}",
            "{{ if eq .Mode \"visual\" }}p:pink{{ end }}",
            "{{ if eq .Mode \"viopp\" }}p:yellow{{ end }}",
            "{{ if eq .Mode \"replace\" }}p:red{{ end }}"
          ],
          "trailing_diamond": "\ue0bc"
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:green",
    "foreground_templates": [
      "{{ if gt .Code 0 }}p:red{{ end }}"
    ],
    "template": "\u276f "
  },
  "palette": {
    "os": "#ACB0BE",
    "pink": "#F5BDE6",
    "lavender": "#B7BDF8",
    "blue": "#8AADF4",
    "wight": "#FFFFFF",
    "text": "#494D64",
    "peach": "#F5A97F",
    "orange": "#FFB020",
    "green": "#A6DA95",
    "red": "#ED8796",
    "yellow": "#EED49F",
    "overlay": "#6E738D"
  },
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": true,
    "notice": true
  }
}
