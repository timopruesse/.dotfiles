{
  "hooks": {
    "sessionEnd": [
      {
        "command": "./hooks/log-session.sh"
      }
    ],
    "sessionStart": [
      {
        "command": "./hooks/log-session.sh"
      },
      {
        "command": "bash \"$HOME/.cursor/herdr-agent-state.sh\" session"
      }
    ],
    "subagentStop": [
      {
        "command": "./hooks/log-session.sh"
      }
    ],
    "preToolUse": [
      {
        "matcher": "Shell",
        "command": "bash \"$HOME/.cursor/hooks/pane-context-aws.sh\""
      }
    ],
    "afterShellExecution": [
      {
        "command": "bash \"$HOME/.cursor/hooks/pane-context-aws.sh\""
      }
    ]
  },
  "version": 1
}
