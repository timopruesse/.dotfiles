{
  "hooks": {
    "afterShellExecution": [
      {
        "command": "bash \"$HOME/.cursor/hooks/pane-context-aws.sh\""
      }
    ],
    "preToolUse": [
      {
        "command": "bash \"$HOME/.cursor/hooks/pane-context-aws.sh\"",
        "matcher": "Shell"
      }
    ],
    "sessionStart": [
      {
        "command": "bash \"$HOME/.cursor/herdr-agent-state.sh\" session"
      },
      {
        "command": "bash '/home/timo/.cursor/herdr-agent-state.sh' session"
      }
    ]
  },
  "version": 1
}