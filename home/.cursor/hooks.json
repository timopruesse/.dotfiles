{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/log-session.sh"
      },
      {
        "command": "bash \"$HOME/.cursor/herdr-agent-state.sh\" session"
      }
    ],
    "subagentStop": [
      {
        "command": "./hooks/log-session.sh"
      }
    ],
    "sessionEnd": [
      {
        "command": "./hooks/log-session.sh"
      }
    ]
  }
}
